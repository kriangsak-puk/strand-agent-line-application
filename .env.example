# Copy to .env and fill in real values. Never commit .env.

# --- Web search tool ---
# Default is agent/search_tool.py (DuckDuckGo via ddgs) — no API key needed.
# No variables required here unless you swap in Tavily/Exa later.

# --- Model provider: Amazon Bedrock (default) ---
# Needs local AWS credentials with Bedrock model access enabled in the region below.
AWS_PROFILE=
AWS_REGION=

# Optional: override the Bedrock model id (default: cheapest current Claude,
# see agent/core.py:DEFAULT_BEDROCK_MODEL_ID). Must be enabled for your account/region.
# Example: BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_ID=

# --- Optional model override (see PLAN.md §12) ---
# Only if you want to bypass Bedrock (e.g. it's unavailable) — set this and
# agent/core.py:_select_model() switches to Gemini instead.
# Example: GEMINI_KEY=AQ.Ab8xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_KEY=
# Optional: override the Gemini model id (default: cheapest current tier,
# see agent/core.py:DEFAULT_GEMINI_MODEL_ID). Only used when GEMINI_KEY is set.
# Example: GEMINI_MODEL_ID=gemini-2.0-flash
GEMINI_MODEL_ID=

# --- LINE Messaging API (from the LINE Developers Console) ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- Agent backend switch ---
# local     -> in-process strands.Agent (development)
# agentcore -> boto3 invoke_agent_runtime against a deployed AgentCore Runtime
AGENT_BACKEND=local

# --- Required only when AGENT_BACKEND=agentcore ---
AGENTCORE_AGENT_RUNTIME_ARN=
